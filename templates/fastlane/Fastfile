# Copia a ios/fastlane/Fastfile y ajusta APP_ID, WORKSPACE, SCHEME y XCODEPROJ.
default_platform(:ios)

APP_ID    = "com.tuempresa.nombreapp"
WORKSPACE = "App.xcworkspace"
SCHEME    = "App"
XCODEPROJ = "App.xcodeproj"

platform :ios do
  desc "Build de release y subida a TestFlight"
  lane :beta do
    setup_ci  # keychain temporal en CI

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(type: "appstore", app_identifier: APP_ID, readonly: true, api_key: api_key)

    increment_build_number(
      build_number: latest_testflight_build_number(app_identifier: APP_ID, api_key: api_key) + 1,
      xcodeproj: XCODEPROJ
    )

    build_app(workspace: WORKSPACE, scheme: SCHEME, export_method: "app-store")

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
